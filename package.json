{
  "name": "pension-sim-de",
  "version": "0.0.0",
  "private": true,
  "description": "Altersvorsorge-Simulator (DE)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kindermann-dev/pension-sim-de"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze": "vite build --mode analyze",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "build": "tsc -b && vite build",
    "clean": "rm -rf dist coverage",
    "dev": "vite",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,scss,html,md}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,css,scss,html,md}'",
    "lint": "oxlint && stylelint \"src/**/*.css\" && htmlhint index.html",
    "lint:fix": "oxlint --fix && stylelint \"src/**/*.css\" --fix && htmlhint index.html",
    "prepare": "husky",
    "preview": "vite preview",
    "release:check": "npm run lint && npm run test && npm run build && npm audit --audit-level=moderate",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "happy-dom": "^20.11.2",
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
