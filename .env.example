# ==========================================
# Legal & Impressum Configuration
# ==========================================
# Diese Variablen können in GitHub unter:
# Settings -> Secrets and variables -> Actions (Repository Secrets)
# hinterlegt werden. Bei Nichtangabe greifen die Standard-Musterdaten.
#
# Alle Daten werden beim Build automatisch in Base64 konvertiert und im
# Frontend per Click-to-Reveal vor Web-Scrapern geschützt (§ 5 DDG-konform).

# Angaben gemäß § 5 DDG & § 18 Abs. 2 MStV
LEGAL_NAME="Max Mustermann"
LEGAL_STREET="Musterstraße 12"
LEGAL_CITY="12345 Musterstadt"
LEGAL_COUNTRY="Deutschland"

# Kontaktdaten
LEGAL_PHONE="+49 123 456789"
LEGAL_EMAIL="max.mustermann@beispiel.de"

# Datenschutz-Kontakt
PRIVACY_EMAIL="datenschutz@beispiel.de"

# Optional: Redaktionell Verantwortlicher (falls abweichend von LEGAL_*)
LEGAL_EDITORIAL_NAME="Max Mustermann"
LEGAL_EDITORIAL_STREET="Musterstraße 12"
LEGAL_EDITORIAL_CITY="12345 Musterstadt"
LEGAL_EDITORIAL_COUNTRY="Deutschland"
